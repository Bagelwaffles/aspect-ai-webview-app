# Aspect Marketing Solutions - environment reference
# Copy to .env.local for local development. Never commit real values.
# Every value below is a placeholder or non-secret local URL.

# -----------------------------------------------------------------------------
# Application and customer authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aspect Marketing Solutions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Exact Google account allowed to elevate into the internal AMS operator session.
# This is an allowlist, not a password or a substitute for Google authentication.
AMS_OWNER_EMAIL=owner@example.com

# Internal API access for staff/system routes. Never expose through NEXT_PUBLIC_*.
AMS_INTERNAL_API_KEY=replace-with-a-long-random-value

# Optional legacy internal admin login. Store only a scrypt-v1 password hash; never the password.
INTERNAL_ADMIN_EMAIL=internal-admin@aspectmarketingsolutions.app
INTERNAL_ADMIN_PASSWORD_HASH='scrypt-v1$replace-with-base64url-salt$replace-with-base64url-digest'
# Independent random session-signing key used by the operator session bridge and legacy admin login.
INTERNAL_ADMIN_SECRET=replace-with-an-independent-long-random-session-secret

# Optional per-instance AI request ceiling. Defaults to 10/minute, maximum 60.
AMS_AI_REQUESTS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Vercel-native AI agents
# -----------------------------------------------------------------------------
# Paid customer Content Agent execution is explicitly opt-in.
NEXT_PUBLIC_AMS_CONTENT_AGENT_LIVE=false
AMS_CONTENT_AGENT_MODEL=openai/gpt-5.4-mini
# Internal AMS Social Campaign Agent uses the same Vercel AI Gateway runtime.
AMS_SOCIAL_CAMPAIGN_MODEL=openai/gpt-5.4-mini
# Vercel deployments authenticate AI Gateway through native deployment OIDC when using
# the AI SDK provider/model form. For local/non-Vercel execution only, an explicit
# server-side API key remains an optional fallback.
AI_GATEWAY_API_KEY=

# Relevance AI - rotate any credential previously exposed in repository history.
RELEVANCE_API_KEY=replace-with-rotated-relevance-api-key
RELEVANCE_AUTH_TOKEN=replace-with-rotated-relevance-auth-token
RELEVANCE_PROJECT_ID=replace-with-relevance-project-id
RELEVANCE_REGION=replace-with-relevance-region
RELEVANCE_AGENT_API_URL=https://api.example.invalid

# -----------------------------------------------------------------------------
# Persistent entitlements, rate limits, idempotency, agent runs, and Android beta roster
# Use one matching URL/token pair. Do not mix credentials from different stores.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# KV_REST_API_URL=https://replace-with-vercel-kv-rest-url
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token

# Official Google Play closed-test opt-in URL. Leave unset until Play Console creates it.
AMS_ANDROID_CLOSED_TEST_URL=https://play.google.com/apps/testing/com.example.placeholder

# -----------------------------------------------------------------------------
# Vercel-native social publishing adapters - server side only
# The Social Campaign Agent can generate and persist drafts without these credentials.
# Publishing remains approval-first and fails closed when a channel is not configured.
# -----------------------------------------------------------------------------
AMS_LINKEDIN_ACCESS_TOKEN=replace-with-linkedin-oauth-access-token
AMS_LINKEDIN_AUTHOR_URN=urn:li:organization:replace_me
# LinkedIn Posts API version in YYYYMM format. Set to a currently supported version.
AMS_LINKEDIN_API_VERSION=replace-with-yyyyMM

# Pinterest requires OAuth plus board/media information. Adapter intentionally remains
# disabled until those are reconnected and verified.
# AMS_PINTEREST_ACCESS_TOKEN=replace-with-pinterest-oauth-access-token
# AMS_PINTEREST_BOARD_ID=replace-with-pinterest-board-id

# Facebook/Instagram and YouTube publishing credentials are intentionally omitted until
# their current OAuth/app configuration is reconnected and the adapters are verified.

# -----------------------------------------------------------------------------
# Stripe - test mode for staging and local verification
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_WEBHOOK_MODE=test
AMS_STRIPE_STARTER_PRICE_ID=price_replace_starter
AMS_STRIPE_GROWTH_PRICE_ID=price_replace_growth
AMS_STRIPE_PRO_PRICE_ID=price_replace_pro

# Optional server-side backend used only by the request-only service intake.
AMS_BACKEND_URL=https://replace-with-staging-backend.example
AMS_STRIPE_FULFILLMENT_SECRET=replace-with-staging-backend-secret

# -----------------------------------------------------------------------------
# Legacy n8n compatibility only - not required for AMS core operation
# Leave unset when using the Vercel-native agent orchestrator.
# -----------------------------------------------------------------------------
# AMS_N8N_URL=https://replace-with-your-n8n-host
# AMS_N8N_ORCHESTRATOR_WEBHOOK_URL=https://replace-with-your-n8n-host/webhook/ams-orchestrator
# AMS_N8N_AUDIT_WEBHOOK_URL=https://replace-with-your-n8n-host/webhook/ams-audit-system
# AMS_N8N_INTERNAL_KEY=replace-with-a-new-random-header-auth-secret

# Quick Marketing Audit checkout stays fail-closed until dedicated Stripe credentials,
# approved price IDs, webhook secrets, public sales enablement, and verified fulfillment
# are all configured. In production AMS_QUICK_AUDIT_FULFILLMENT_READY must be explicitly true.
AMS_STRIPE_QUICK_AUDIT_SECRET_KEY=sk_test_replace_me
AMS_STRIPE_QUICK_AUDIT_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_QUICK_AUDIT_PRICE_ID=price_replace_quick_audit_test
AMS_STRIPE_QUICK_AUDIT_LIVE_SECRET_KEY=rk_live_replace_me
AMS_STRIPE_QUICK_AUDIT_LIVE_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_QUICK_AUDIT_LIVE_PRICE_ID=price_replace_quick_audit_live
AMS_QUICK_AUDIT_PUBLIC_SALES_ENABLED=false
AMS_QUICK_AUDIT_FULFILLMENT_READY=false
AMS_APP_URL=http://localhost:3000

# Obsolete names that must not be reintroduced:
# N8N_BASE_URL
# N8N_WEBHOOK_SECRET
# N8N_API_KEY

# -----------------------------------------------------------------------------
# Optional integrations not required for the Content Agent launch
# -----------------------------------------------------------------------------
PRINTIFY_API_KEY=replace-with-printify-api-key

# Local runtime
NODE_ENV=development

# Safe setup order:
# 1. Use Stripe test keys and test price IDs.
# 2. Use a dedicated Google OAuth test client and set one exact AMS_OWNER_EMAIL.
# 3. Configure one valid Upstash/Vercel KV URL and token pair.
# 4. Keep customer Content Agent execution false until AI Gateway credits and an E2E run are verified.
# 5. Rotate historically exposed Relevance credentials before enabling them.
# 6. Keep n8n unset unless a non-core legacy workflow is deliberately restored.
# 7. Reconnect social OAuth credentials one platform at a time; approval must remain required.
# 8. Add AMS_ANDROID_CLOSED_TEST_URL only after Play Console provides the official opt-in URL.
# 9. Keep Quick Audit fulfillment readiness false until the end-to-end delivery path is verified.
# 10. Keep every secret server-side and out of source, logs, tickets, and chat.
