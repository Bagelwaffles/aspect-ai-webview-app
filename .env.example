# Aspect Marketing Solutions - environment reference
# Copy to .env.local for local development. Never commit real values.

# -----------------------------------------------------------------------------
# Application and customer authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aspect Marketing Solutions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Internal API access for staff/system routes. Do not expose in browser code.
AMS_INTERNAL_API_KEY=replace-with-a-long-random-value

# Optional per-instance AI request ceiling. Defaults to 10/minute, maximum 60.
AMS_AI_REQUESTS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# AI provider for the first launch agent (Content Agent)
# -----------------------------------------------------------------------------
XAI_API_KEY=replace-with-xai-api-key
XAI_MODEL=replace-with-enabled-xai-model

# Relevance AI - rotate any credential previously exposed in public history first.
RELEVANCE_API_KEY=replace-with-rotated-relevance-api-key
RELEVANCE_AUTH_TOKEN=replace-with-rotated-relevance-auth-token
RELEVANCE_PROJECT_ID=replace-with-relevance-project-id
RELEVANCE_REGION=replace-with-relevance-region
RELEVANCE_AGENT_API_URL=https://api.example.invalid

# -----------------------------------------------------------------------------
# Persistent entitlements and credits
# Use the existing Upstash/Vercel KV REST credentials. Either naming pair works.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# KV_REST_API_URL=https://replace-with-vercel-kv-rest-url
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token

# -----------------------------------------------------------------------------
# Stripe - test mode for staging
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_WEBHOOK_MODE=test
AMS_STRIPE_STARTER_PRICE_ID=price_replace_starter
AMS_STRIPE_GROWTH_PRICE_ID=price_replace_growth
AMS_STRIPE_PRO_PRICE_ID=price_replace_pro

# Optional server-side backend used only by the request-only service intake.
AMS_BACKEND_URL=https://replace-with-staging-backend.example
AMS_STRIPE_FULFILLMENT_SECRET=replace-with-staging-backend-secret

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_BASE_URL=https://replace-with-your-n8n-host
N8N_WEBHOOK_SECRET=replace-with-a-long-random-value

# -----------------------------------------------------------------------------
# Optional integrations not required for the Content Agent launch
# -----------------------------------------------------------------------------
PRINTIFY_API_KEY=replace-with-printify-api-key

# Local runtime
NODE_ENV=development

# Staging order:
# 1. Use Stripe test keys and test price IDs.
# 2. Use a dedicated Google OAuth test client.
# 3. Use existing Upstash/Vercel KV REST credentials or a staging database.
# 4. Add XAI credentials only after account authentication and entitlements work.
# 5. Keep Relevance disabled until the exposed credentials are rotated.
# 6. Verify /api/health, sign-in, checkout, signed webhook fulfillment, credits,
#    and the Content Agent before any production promotion.
