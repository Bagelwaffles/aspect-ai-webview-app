# Aspect Marketing Solutions - environment reference
# Copy to .env.local for local development. Never commit real values.
# Every value below is a placeholder or non-secret local URL.

# -----------------------------------------------------------------------------
# Application and customer authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aspect Marketing Solutions
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Exact Google account allowed to elevate into the internal AMS operator session.
# This is an allowlist, not a password or a substitute for Google authentication.
AMS_OWNER_EMAIL=owner@example.com

# Internal API access for staff/system routes. Never expose through NEXT_PUBLIC_*.
AMS_INTERNAL_API_KEY=replace-with-a-long-random-value

# Optional legacy internal admin login. Store only a scrypt-v1 password hash; never the password.
INTERNAL_ADMIN_EMAIL=internal-admin@aspectmarketingsolutions.app
INTERNAL_ADMIN_PASSWORD_HASH='scrypt-v1$replace-with-base64url-salt$replace-with-base64url-digest'
# Independent random session-signing key used by the operator session bridge and legacy admin login.
INTERNAL_ADMIN_SECRET=replace-with-an-independent-long-random-session-secret

# Optional per-instance AI request ceiling. Defaults to 10/minute, maximum 60.
AMS_AI_REQUESTS_PER_MINUTE=10

# -----------------------------------------------------------------------------
# AI provider for the first launch agent (Content Agent)
# -----------------------------------------------------------------------------
XAI_API_KEY=replace-with-xai-api-key
XAI_MODEL=replace-with-enabled-xai-model

# Relevance AI - rotate any credential previously exposed in repository history.
RELEVANCE_API_KEY=replace-with-rotated-relevance-api-key
RELEVANCE_AUTH_TOKEN=replace-with-rotated-relevance-auth-token
RELEVANCE_PROJECT_ID=replace-with-relevance-project-id
RELEVANCE_REGION=replace-with-relevance-region
RELEVANCE_AGENT_API_URL=https://api.example.invalid

# -----------------------------------------------------------------------------
# Persistent entitlements, rate limits, and idempotency
# Use one matching URL/token pair. Do not mix credentials from different stores.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# KV_REST_API_URL=https://replace-with-vercel-kv-rest-url
# KV_REST_API_TOKEN=replace-with-vercel-kv-rest-token

# -----------------------------------------------------------------------------
# Stripe - test mode for staging and local verification
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_WEBHOOK_MODE=test
AMS_STRIPE_STARTER_PRICE_ID=price_replace_starter
AMS_STRIPE_GROWTH_PRICE_ID=price_replace_growth
AMS_STRIPE_PRO_PRICE_ID=price_replace_pro

# Optional server-side backend used only by the request-only service intake.
AMS_BACKEND_URL=https://replace-with-staging-backend.example
AMS_STRIPE_FULFILLMENT_SECRET=replace-with-staging-backend-secret

# -----------------------------------------------------------------------------
# n8n Cloud gateway - server side only
# The same newly rotated AMS_N8N_INTERNAL_KEY must be stored in the n8n Header
# Auth credential using header name x-ams-internal-key.
# -----------------------------------------------------------------------------
AMS_N8N_URL=https://replace-with-your-n8n-host
AMS_N8N_ORCHESTRATOR_WEBHOOK_URL=https://replace-with-your-n8n-host/webhook/ams-orchestrator
AMS_N8N_INTERNAL_KEY=replace-with-a-new-random-header-auth-secret
AMS_APP_URL=http://localhost:3000

# Obsolete names that must not be reintroduced:
# N8N_BASE_URL
# N8N_WEBHOOK_SECRET
# N8N_API_KEY

# -----------------------------------------------------------------------------
# Optional integrations not required for the Content Agent launch
# -----------------------------------------------------------------------------
PRINTIFY_API_KEY=replace-with-printify-api-key

# Local runtime
NODE_ENV=development

# Safe setup order:
# 1. Use Stripe test keys and test price IDs.
# 2. Use a dedicated Google OAuth test client and set one exact AMS_OWNER_EMAIL.
# 3. Configure one valid Upstash/Vercel KV URL and token pair.
# 4. Rotate historically exposed Relevance credentials before enabling them.
# 5. Store the same new n8n Header Auth secret in n8n and Vercel.
# 6. Keep every secret server-side and out of source, logs, tickets, and chat.
