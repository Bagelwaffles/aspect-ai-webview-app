{
  "version": 2,
  "routes": [
    {
      "src": "^/(?!api/internal/quick-audit-pilot/webhook$).*",
      "has": [
        {
          "type": "host",
          "value": {
            "re": "^aspect-ai-overlord-[a-z0-9]{7,14}-kimberleyaversbiz-4131s-projects\\.vercel\\.app$"
          }
        }
      ],
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/monitoring/run",
      "schedule": "17 13 * * *"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_NAME": "Aspect Marketing Solutions",
    "NEXT_PUBLIC_APP_URL": "https://www.aspectmarketingsolutions.app"
  }
}
