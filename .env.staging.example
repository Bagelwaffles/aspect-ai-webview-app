# Copy to .env.staging and replace every placeholder. Never commit .env.staging.
# Every value below is a placeholder or non-secret staging URL.

# Isolated staging identity. Replace with one dedicated HTTPS origin.
NEXT_PUBLIC_APP_URL=https://replace-with-staging-host.example
PUBLIC_APP_URL=https://replace-with-staging-host.example
NEXTAUTH_URL=https://replace-with-staging-host.example
NEXTAUTH_SECRET=replace-with-a-long-random-staging-secret
GOOGLE_CLIENT_ID=replace-with-dedicated-staging-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-dedicated-staging-google-client-secret
AMS_INTERNAL_API_KEY=replace-with-a-long-random-staging-key

# Internal admin login. Store only a scrypt-v1 password hash; never the password.
INTERNAL_ADMIN_EMAIL=internal-admin@aspectmarketingsolutions.app
INTERNAL_ADMIN_PASSWORD_HASH='scrypt-v1$replace-with-base64url-salt$replace-with-base64url-digest'
INTERNAL_ADMIN_SECRET=replace-with-an-independent-long-random-staging-session-secret

# Redis REST token shared only by the private staging proxy and web container.
AMS_STAGING_REDIS_REST_TOKEN=replace-with-a-long-random-staging-token

# Stripe test mode only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
AMS_STRIPE_WEBHOOK_MODE=test
AMS_STRIPE_STARTER_PRICE_ID=price_replace_starter_test
AMS_STRIPE_GROWTH_PRICE_ID=price_replace_growth_test
AMS_STRIPE_PRO_PRICE_ID=price_replace_pro_test

# Content Agent test provider.
XAI_API_KEY=replace-with-staging-xai-key
XAI_MODEL=replace-with-enabled-staging-model
AMS_AI_REQUESTS_PER_MINUTE=10

# Optional launch integrations. Keep unset until credentials are rotated.
RELEVANCE_API_KEY=
RELEVANCE_AUTH_TOKEN=
RELEVANCE_PROJECT_ID=
RELEVANCE_REGION=
RELEVANCE_AGENT_API_URL=

# n8n Cloud gateway. The same new secret must be stored in the n8n Header Auth
# credential with header name x-ams-internal-key.
AMS_N8N_URL=
AMS_N8N_ORCHESTRATOR_WEBHOOK_URL=
AMS_N8N_INTERNAL_KEY=
AMS_APP_URL=https://replace-with-staging-host.example

# Obsolete and intentionally removed: N8N_BASE_URL, N8N_WEBHOOK_SECRET, N8N_API_KEY.

# Loopback-only host port for the web container.
AMS_STAGING_WEB_PORT=3000
